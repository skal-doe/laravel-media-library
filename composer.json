{
  "name": "skaldoe/laravel-media-library",
  "description": "Médiathèque réutilisable (dossiers, upload, attachments polymorphiques) pour projets Laravel",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/database": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0",
    "illuminate/validation": "^11.0|^12.0",
    "illuminate/events": "^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.11",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "SkalDoe\\MediaLibrary\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SkalDoe\\MediaLibrary\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SkalDoe\\MediaLibrary\\MediaLibraryServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
