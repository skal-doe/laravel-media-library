{
  "name": "skaldoe/laravel-media-library",
  "description": "Médiathèque réutilisable (dossiers, upload, attachments polymorphiques) pour projets Laravel",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "SkalDoe\\MediaLibrary\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SkalDoe\\MediaLibrary\\MediaLibraryServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
